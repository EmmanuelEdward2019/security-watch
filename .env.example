# Project Settings → API: copy Project URL and anon public key (never use the literal "your-project" hostname)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SITE_URL=https://your-domain.com

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Do not expose production API keys in Vite (client). Emails are sent from Edge Functions.
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets (or `supabase secrets set`):
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM_EMAIL=The Security Watch <noreply@your-verified-domain.com>
#   SEND_EMAIL_HOOK_SECRET=whsec_xxxxxxxx   # Auth → Hooks → Send Email → signing secret
#
# Optional: match VITE_SITE_URL for links inside auth emails
